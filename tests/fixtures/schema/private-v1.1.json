        {
            "name": "update_love_making_timestamp",
            "sql": "CREATE TRIGGER update_love_making_timestamp         --自动更新时间触发器\nAFTER UPDATE ON love_making\nFOR EACH ROW\nBEGIN\n    UPDATE love_making\n    SET update_time = DATETIME('now', 'localtime')\n    WHERE love_making_id = OLD.love_making_id;\nEND",
            "table": "love_making",
            "type": "trigger"
        },
