#version 430
layout(local_size_x = 128) in;
layout(std140, binding = 0) uniform Counts {
    uvec4 counts;
    vec4 view; // physical pixels per world unit (x,y), pan (x,y)
    vec4 center; // viewport center in physical pixels
};
layout(std430, binding = 1) readonly buffer State { float state[]; };
layout(std430, binding = 2) readonly buffer Source { float source[]; };
layout(std430, binding = 3) writeonly buffer Output { float outputVertices[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= counts.x) return;
    uint b = i * 12u;
    uint node = uint(source[b + 9u]);
    vec2 anchor = vec2(state[5u * node], state[5u * node + 1u]) + vec2(source[b + 10u], source[b + 11u]);
    vec2 pixel = (anchor - view.zw) * view.xy + center.xy;
    anchor = (floor(pixel + 0.5) - center.xy) / view.xy + view.zw;
    for (uint j = 0u; j < 12u; ++j) outputVertices[b + j] = source[b + j];
    outputVertices[b] += anchor.x;
    outputVertices[b + 1u] += anchor.y;
}
